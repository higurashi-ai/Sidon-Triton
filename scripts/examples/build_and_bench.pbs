#!/bin/bash
# Example batch job (PBS Pro) wrapping a workflow script. Adjust the
# resource request, account/group and module lines for your cluster.
#PBS -N sidon-triton-build
#PBS -l select=1:ngpus=1
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR}"
# module load cuda/12.9          # nvcc for the CUDA tail kernels
export STRITON_WORK="${PBS_LOCALDIR:-${TMPDIR:-/tmp}}/sidon_triton"
# EVAL_WAVS: space-separated inputs for the parity check (qsub -v EVAL_WAVS=...)
# shellcheck disable=SC2086
scripts/workflows/build_and_bench.sh ${EVAL_WAVS:-}
